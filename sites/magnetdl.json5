{
  "enabled": false,
  "name": "magnetdl.com",
  "fullname": "magnetdl",
  "url": "https://www.magnetdl.com",
  "urls": [
    "https://www.magnetdl.com",
    "https://freeproxy.io/magnetdl-proxy/",
    "https://magnetdl.nl/",
    "https://magnetdl.me/",
    "https://sitenable.info/magnetdl-proxy/"
  ],
  "search": "/{query[0]}/{query}/se/desc/",
  "whitespace": "-",
  "headers": {
    "Accept": "*/*;"
  },
  "list": {
    "items": "table.download > tbody > tr:has(> td.n)",
    "item": {
      "name": "td.n > a @ text",
      "info_url": "td.n > a @ href",
      "size": "td:nth-of-type(6) @ text",
      "time": "td:nth-of-type(3) @ text",
      "seeds": "td.s @ text",
      "leeches": "td.l @ text",
      "magnet": "td.m > a @ href"
    },
    "next": "#pages > a:contains(Next) @ href"
  }
}